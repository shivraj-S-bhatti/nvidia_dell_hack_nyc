# ExitTwin config — copy to `.env` and edit. Real env vars override these.
# (`.env` is gitignored; never put secrets here — this repo is public.)

# --- Local inference endpoint --------------------------------------------------
# Default: host route, for a process running on the GB10 host.
EXITTWIN_LLM_BASE_URL=http://127.0.0.1:8000/v1
# Inside the OpenShell harness sandbox, comment the line above and use:
# EXITTWIN_LLM_BASE_URL=http://host.openshell.internal:8000/v1
#   (the sandbox container must be attached to the `openshell-docker` network)
EXITTWIN_LLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
EXITTWIN_LLM_MAX_CONCURRENCY=4

# --- Storage -------------------------------------------------------------------
# Leave MONGODB_URI empty to use the zero-dependency JSON store (pull-and-run).
# On the box, point it at the real MongoDB to use the live collections:
# EXITTWIN_MONGODB_URI=mongodb://127.0.0.1:27017
EXITTWIN_MONGODB_URI=
EXITTWIN_MONGODB_DB=exittwin

# --- Offline posture -----------------------------------------------------------
# 1 = never touch the network; use only cached/seeded NYC records (demo posture).
EXITTWIN_OFFLINE=0
