{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/attempt1/physgen/object/asset-manifest.schema.json",
  "title": "NeoRacer offline asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assetId",
    "source",
    "cache",
    "artifacts",
    "toolchain",
    "loadContract"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "assetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryUrl", "commitSha", "license"],
      "properties": {
        "repositoryUrl": {"type": "string", "pattern": "^https://github\\.com/"},
        "commitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "repositoryPath", "sha256", "sizeBytes"],
          "properties": {
            "spdx": {"const": "CERN-OHL-S-2.0"},
            "repositoryPath": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "sizeBytes": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryRelativePath"],
      "properties": {
        "repositoryRelativePath": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "role", "repositoryPath", "sha256", "sizeBytes", "lfsOidSha256"],
        "properties": {
          "artifactId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "role": {"enum": ["source-assembly-step", "source-assembly-freecad", "source-component-step"]},
          "repositoryPath": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sizeBytes": {"type": "integer", "minimum": 1},
          "lfsOidSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "cadquery", "cadqueryOcp", "openCascade", "freeCAD", "modelInventory"],
      "properties": {
        "python": {"const": "3.12"},
        "cadquery": {"const": "2.8.0"},
        "cadqueryOcp": {"const": "7.9.3.1.1"},
        "openCascade": {"const": "7.9.3"},
        "freeCAD": {"type": ["string", "null"]},
        "modelInventory": {"const": []}
      }
    },
    "loadContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "requiredOfflineLoads", "allowRepair"],
      "properties": {
        "units": {"const": "mm"},
        "requiredOfflineLoads": {"type": "integer", "minimum": 3},
        "allowRepair": {"const": false}
      }
    }
  }
}
